# Copy to /opt/grjngo/docker/.env  (chmod 600 - it holds secrets)

# NordVPN via WireGuard (NordLynx). See README for how to get the private key.
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
# ...or OpenVPN with your Nord *service* credentials (not your login):
# VPN_TYPE=openvpn
# OPENVPN_USER=
# OPENVPN_PASSWORD=

# Comma-separated; a random server from these countries is used each run
SERVER_COUNTRIES=United States

TMDB_API_KEY=

# Where the movies go: the SMB mount inside this LXC (ErsatzTV's library folder)
LIBRARY_DIR=/mnt/westerns
# Owner of new files - match what the SMB mount shows (ls -ln /mnt/westerns)
PUID=1000
PGID=1000

TZ=America/Denver
